---
// Mención de autoría en el pie. El tooltip aparece solo en hover/foco del
// enlace: en móvil no se muestra (no hay hover) y el enlace sigue funcionando.
//
// Va centrado sobre el enlace y sobresale hacia la derecha del contenedor. Por
// debajo de 1400px de viewport ya no cabe (se saldría de la pantalla) y se
// ancla al borde derecho del enlace; la flecha lo sigue en ambos casos.
---

<span class="relative inline-block">
  <a
    href="https://ctgcode.com"
    target="_blank"
    rel="noopener"
    class="peer text-stone-300 hover:text-amber-500 focus-visible:text-amber-500 font-semibold transition-colors"
  >
    CTG Code
  </a>

  <span
    role="presentation"
    class="pointer-events-none absolute bottom-full right-0 z-20 mb-3 w-56 translate-y-1 rounded-xl bg-[#F6F1E7] p-4 text-center opacity-0 shadow-xl shadow-black/40 transition duration-200 peer-hover:translate-y-0 peer-hover:opacity-100 peer-focus-visible:translate-y-0 peer-focus-visible:opacity-100 min-[1400px]:left-[calc(50%-7rem)] min-[1400px]:right-auto"
  >
    <svg viewBox="0 0 200 200" aria-hidden="true" class="mx-auto h-12 w-12">
      <g stroke="#0C2233" stroke-width="9" stroke-linecap="square" stroke-linejoin="miter" fill="none">
        <path d="M46 34 L36 42 L36 92 L26 100 L36 108 L36 158 L46 166" />
        <path d="M154 34 L164 42 L164 92 L174 100 L164 108 L164 158 L154 166" />
      </g>
      <g fill="#F4A24C">
        <path d="M100 50 L107 66 L93 66 Z" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(45 100 100)" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(90 100 100)" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(135 100 100)" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(180 100 100)" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(225 100 100)" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(270 100 100)" />
        <path d="M100 50 L107 66 L93 66 Z" transform="rotate(315 100 100)" />
      </g>
      <circle cx="100" cy="100" r="22" fill="none" stroke="#F4A24C" stroke-width="8" />
    </svg>

    <span class="mt-2 block text-sm font-bold text-[#0C2233]">Cotiza tu proyecto</span>
    <span class="mt-1 block text-xs leading-snug text-[#0C2233]/70">Sitios web y software a la medida</span>

    <span
      class="absolute right-[24px] top-full h-3 w-3 -translate-y-1/2 rotate-45 rounded-[2px] bg-[#F6F1E7] min-[1400px]:left-[calc(50%-0.375rem)] min-[1400px]:right-auto"
    ></span>
  </span>
</span>
