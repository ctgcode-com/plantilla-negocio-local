---
import Layout from '../templates/local/Layout.astro';
import Nav from '../templates/local/Nav.astro';
import Hero from '../templates/local/Hero.astro';
import About from '../templates/local/About.astro';
import Menu from '../templates/local/Menu.astro';
import Gallery from '../templates/local/Gallery.astro';
import LocationHours from '../templates/local/LocationHours.astro';
import Footer from '../templates/local/Footer.astro';
import { data } from '../templates/local/data';

const title = `${data.brand.name} — ${data.brand.tagline}`;
const description = data.hero.subtitle;

/**
 * En la demo publicada bajo ctgcode.com el negocio no existe: declararlo como
 * `Restaurant` —con dirección y teléfono— haría que un buscador lo tomara por
 * una ficha legítima. El marcado sale solo cuando la plantilla es de un
 * cliente real (ver PUBLIC_DEMO en el README).
 */
const isDemo = import.meta.env.PUBLIC_DEMO === 'true';

// Schema.org pide URL absoluta; en los datos la portada es una ruta local.
const heroImageUrl = new URL(data.hero.backgroundImage, Astro.site ?? 'https://ctgcode.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: data.brand.name,
  description: data.footer.description,
  servesCuisine: 'Colombiana',
  priceRange: '$$',
  image: heroImageUrl,
  telephone: data.contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: data.location.address,
    addressLocality: 'Bogotá',
    addressCountry: 'CO',
  },
};
---

<Layout title={title} description={description} heroPreload={data.hero.backgroundImage}>
  <Fragment slot="head">
    {!isDemo && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </Fragment>
  <Nav data={data} />
  <main>
    <Hero data={data} />
    <About data={data} />
    <Menu data={data} />
    <Gallery data={data} />
    <LocationHours data={data} />
  </main>
  <Footer data={data} />
</Layout>
